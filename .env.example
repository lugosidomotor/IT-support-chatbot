# ---------------------------------------------------------------------------
# LLM (OpenRouter via the Claude Agent SDK's Anthropic-compatible integration)
# ---------------------------------------------------------------------------
# Required for chatting. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Explicit OpenRouter model id. Empty = documented default anthropic/claude-sonnet-5.5
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_BASE_URL=https://openrouter.ai/api
# Check key + model id against OpenRouter at startup (true/false)
OPENROUTER_VALIDATE_MODEL=true
# Bounded retries / per-request timeout for model API calls
LLM_MAX_RETRIES=2
LLM_REQUEST_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------------------
# GitHub (custom read-only MCP adapter). Public repos work WITHOUT a token.
# ---------------------------------------------------------------------------
GITHUB_REPOS=fastapi/fastapi,pydantic/pydantic
# Optional: raises the API limit from 60 to 5000 req/h and enables private repos
GITHUB_TOKEN=
# Optional branch/tag used instead of each repository's default branch
GITHUB_DEFAULT_REF=
GITHUB_MAX_FILES_PER_SEARCH=100
GITHUB_MAX_FILE_BYTES=200000
GITHUB_SEARCH_TIMEOUT_SECONDS=25

# ---------------------------------------------------------------------------
# Atlassian Rovo MCP (Jira + Confluence). Disabled automatically without a key.
# ---------------------------------------------------------------------------
# auto = enabled only when ATLASSIAN_SERVICE_ACCOUNT_API_KEY is set; true / false to force
ATLASSIAN_MCP_ENABLED=auto
ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v2/mcp
ATLASSIAN_SERVICE_ACCOUNT_API_KEY=
# Optional, e.g. https://your-site.atlassian.net (used as cloudId hint for the agent)
ATLASSIAN_SITE_URL=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
AGENT_MAX_TURNS=12
AGENT_TIMEOUT_SECONDS=120
CACHE_TTL_SECONDS=300
